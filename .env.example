# Port the HTTP server listens on (Coolify sets this; default 3000)
PORT=3000

# Public base URL shown on the landing page (optional; falls back to the request origin)
PUBLIC_URL=https://storelint-mcp.embracetech.org

# --- x402 payment gate (storelint_scan only) ---
# Base mainnet address that receives USDC. Unset = free mode (server logs a warning).
X402_PAY_TO=
# Price per storelint_scan call, in USD (settled as USDC). Default $0.05.
X402_PRICE=$0.05
# x402 v2 network id (CAIP-2). Base mainnet = eip155:8453, Base Sepolia = eip155:84532.
X402_NETWORK=eip155:8453
# Facilitator that verifies/settles payments. Default = Coinbase CDP facilitator (the only
# public one that settles on Base mainnet). It requires the CDP API keys below.
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- input limits ---
# Shallow-clone timeout in ms (default 60000) and max checkout size in bytes (default 200 MB)
CLONE_TIMEOUT_MS=60000
MAX_REPO_BYTES=209715200
# Max decoded zip size in bytes (default 50 MB) and max extracted size (default 200 MB)
MAX_ZIP_BYTES=52428800
MAX_EXTRACT_BYTES=209715200

{
  "name": "storelint-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing the StoreLint app-store readiness scanner as a pay-per-call tool (x402, USDC on Base).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsc -p tsconfig.json && node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "2.28.0",
    "@x402/hono": "^2.28.0",
    "hono": "^4.13.13",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "storelint": "github:iddriss/storelint"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.28.2"
}
